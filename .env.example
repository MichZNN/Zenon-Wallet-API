# Copy this file to .env and fill it in. Never commit the .env file.

# Address of the Wallet API server, for example https://localhost:443
ZENON_WALLET_API_URL="https://"

# API users, as configured in the Wallet API (Api:Users in its appsettings).
# Initializing and restoring a wallet need the Admin role; every other call
# needs the User role. One API user can have both roles.
ZENON_WALLET_API_USERNAME_ADMIN=""
ZENON_WALLET_API_PASSWORD_ADMIN=""
ZENON_WALLET_API_USERNAME_USER=""
ZENON_WALLET_API_PASSWORD_USER=""

# Password of the wallet itself, used to initialize, restore and unlock it.
# At least 8 characters with a letter, a digit and one of @$!%*#?&
ZENON_WALLET_API_SECRET=""

# Mnemonic of the wallet, only read by examples/restore_wallet.py.
# A new wallet prints its mnemonic once: see examples/initialize_wallet.py.
ZENON_WALLET_API_MNEMONIC=""

# Address of the wallet account you use most (see: zenon-wallet-api accounts).
# Used as the default address by the command line tool and the examples.
ZENON_WALLET_API_ADDRESS=""
